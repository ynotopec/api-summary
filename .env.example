APP_ENV=production
AUTH_ENABLED=true
PUBLIC_BASE_URL=https://api-summary.example.org
OIDC_ISSUER=https://sso.example.org/realms/organisation
OIDC_AUDIENCE=api-summary
OIDC_SCOPES=summary:read summary:write
# Optional fixed JWKS endpoint; otherwise OIDC discovery is used.
# OIDC_JWKS_URL=https://sso.example.org/realms/organisation/protocol/openid-connect/certs
OIDC_ALGORITHMS=["RS256"]
DATA_DIR=/data
OPENAI_BASE_URL=https://llm.example.org/v1
OPENAI_API_MODEL=ai-summary
OPENAI_API_KEY=
ASYNC_CONCURRENCY=4
REQUEST_TIMEOUT=120
JOB_TIMEOUT=7200
RETENTION_SECONDS=86400
MAX_FILE_BYTES=2147483648
MAX_OWNER_BYTES=8589934592
MAX_STORAGE_BYTES=68719476736
MAX_CHUNK_BYTES=262144
MAX_FILES=20
MAX_JOBS_PER_OWNER=4
MAX_QUEUED_JOBS=100
MAX_INPUT_CHARS=2000000
MAX_PDF_PAGES=2000
MAX_ZIP_ENTRIES=500
MAX_ZIP_EXPANDED_BYTES=1073741824
MAX_ZIP_RATIO=200
CHUNK_TOKENS=6000
REDUCE_TOKENS=16000
SUMMARY_MAX_TOKENS=1000
